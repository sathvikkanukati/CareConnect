DJANGO_SECRET_KEY=replace-this-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# For easiest first run use sqlite. Change to mysql after creating the database.
DB_ENGINE=sqlite
DB_NAME=food_redistribution
DB_USER=root
DB_PASSWORD=your-mysql-password
DB_HOST=127.0.0.1
DB_PORT=3306

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BLOOD_DONATION_COOLDOWN_DAYS=90
PICKUP_QR_TTL_MINUTES=10

# Optional: AI donation photo suggestions for food, clothes, and essentials in the donation form
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
